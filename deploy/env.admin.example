# Dono do banco (roda migrations e pg_dump).
MIGRATION_DATABASE_URL="postgresql://financeiro:TROQUE@127.0.0.1:5432/befluent_finance"

# Opcional: chave GPG pública para cifrar os backups antes da cópia externa.
BACKUP_GPG_RECIPIENT=""
