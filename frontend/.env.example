# ============================================================================
# Be Fluent Finance — variáveis de ambiente da APLICAÇÃO.
# Na VPS: copie para /var/www/financeiro/frontend/.env e `chmod 600`.
# NUNCA coloque valores reais neste arquivo (ele vai para o git).
# A conexão do DONO do banco fica separada, em ../.env.admin (ver
# deploy/env.admin.example) — a aplicação em execução não a conhece.
# ============================================================================

# Conexão da aplicação: papel `financeiro_app` (sem BYPASSRLS, não é dono das
# tabelas — o RLS vale para tudo o que o app faz). Só localhost.
DATABASE_URL="postgresql://financeiro_app:TROQUE@127.0.0.1:5432/befluent_finance"

# Segredo do servidor (≥ 32 caracteres): cifra o segredo do 2FA e assina os
# códigos de backup/e-mail. Gere com: openssl rand -hex 32
# Trocar este valor invalida todos os 2FA cadastrados (todos recadastram).
APP_SECRET=""

# URL pública final (HTTPS). Usada na checagem de origem (CSRF), nos links de
# e-mail e no build — depois de mudar, rode `npm run build` de novo.
NEXT_PUBLIC_APP_URL="https://financeiro.befluentschool.com.br"

# Atrás do Nginx: confiar no X-Real-IP para rate limit e auditoria.
TRUST_PROXY=1

# Sessão: expira após N horas sem uso, e no máximo após N dias.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# E-mail (SMTP da Hostinger, caixa própria do Financeiro). Obrigatório em
# produção: recuperação de senha e cadastro do 2FA dependem dele.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="nao-responda@befluentschool.com.br"
SMTP_PASS=""
EMAIL_FROM="Be Fluent Financeiro <nao-responda@befluentschool.com.br>"

# Opcional: insights e sugestão de categorias com IA (Claude).
ANTHROPIC_API_KEY=""

# Automação por agendador do SO (cron) — endpoint interno /api/cron/sync que
# roda a virada de mês + sincronização bancária sem sessão de usuário.
#   CRON_SECRET  : segredo (≥16 chars) enviado no header x-cron-secret.
#                  Gere com: openssl rand -hex 24. Vazio = endpoint desativado (503).
#   CRON_USER_ID : id (uuid) de um usuário owner/socio em cujo contexto o cron
#                  roda (o RLS precisa de um usuário válido). Veja o id com:
#                    npm run user -- list    (ou consulte public.profiles)
CRON_SECRET=""
CRON_USER_ID=""

# Conexões bancárias (ASAAS / Inter) NÃO usam variáveis de ambiente: as
# credenciais são cadastradas na tela /banco/conexoes e guardadas cifradas no
# banco (AES-256-GCM com APP_SECRET). Nada de segredo de banco aqui.

# Leitura do Beely CRM (tela /crm):
#   postgres → definitiva, papel somente leitura na mesma VPS (deploy/beely-views.sql)
#   supabase → temporária, API REST do Supabase do Beely (chave só no servidor)
#   off      → desligada
BEELY_SOURCE=off
BEELY_READONLY_DATABASE_URL="postgresql://financeiro_leitor:TROQUE@127.0.0.1:5432/beely_crm"
BEELY_SUPABASE_URL=""
BEELY_SUPABASE_ANON_KEY=""

# Pluggy (Open Finance) foi desligada em jul/2026 (substituída pela importação
# de extrato). Não há variáveis da Pluggy nem webhook nesta versão.
